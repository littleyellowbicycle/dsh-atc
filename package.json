{
  "name": "dsh-atc",
  "version": "0.9.0",
  "description": "Agent 空管中心 for DeepSeek Harness: one sidebar panel listing every local agent session (DSH, codex, opencode, WorkBuddy, Gemini) with attention-first grouping and folded history — zero token, host-side inference.",
  "type": "module",
  "main": "./lib/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/littleyellowbicycle/dsh-atc.git"
  },
  "homepage": "https://github.com/littleyellowbicycle/dsh-atc#readme",
  "bugs": {
    "url": "https://github.com/littleyellowbicycle/dsh-atc/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "sidebar",
    "multi-agent",
    "attention",
    "atc",
    "session"
  ],
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.2.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "assets",
    "cordis.patch.yml",
    "atc.example.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/collect.mjs && node --check client/client.js && npm run brand-icons:check",
    "test": "node --test tests/contract.test.mjs",
    "probe": "node scripts/probe.mjs",
    "render-check": "node scripts/render-check.mjs",
    "export-icon": "node scripts/export-icon.mjs 512",
    "live-check": "node scripts/live-check.mjs",
    "prepublishOnly": "npm run check && npm test && npm run audit:privacy",
    "audit:privacy": "node scripts/audit-privacy.mjs",
    "brand-icons": "node scripts/build-brand-icons.mjs",
    "brand-icons:check": "node scripts/build-brand-icons.mjs --check"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-icons": "^16.37.0",
    "ws": "^8.23.0"
  }
}
